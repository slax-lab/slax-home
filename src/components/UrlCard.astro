---
interface Props {
	href: string;
	title: string;
	description?: string;
}

const { href, title, description } = Astro.props;
const hostname = new URL(href).hostname.replace(/^www\./, '');
---

<a class="url-card" href={href} target="_blank" rel="noopener noreferrer">
	<span class="url-card-icon" aria-hidden="true">
		<svg viewBox="0 0 24 24" fill="none">
			<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
			<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
		</svg>
	</span>
	<span class="url-card-body">
		<span class="url-card-title">{title}</span>
		{description && <span class="url-card-description">{description}</span>}
		<span class="url-card-meta">
			<span class="url-card-host">{hostname}</span>
			<span class="url-card-arrow" aria-hidden="true">↗</span>
		</span>
	</span>
</a>

<style>
	.url-card {
		display: flex;
		align-items: flex-start;
		gap: 1rem;
		margin: 2rem 0;
		padding: 1.15rem 1.25rem;
		border: 1px solid var(--rule);
		border-radius: 8px;
		background: var(--bg-deep);
		color: var(--ink);
		font-family: var(--sans);
		text-decoration: none;
		transition:
			border-color 0.2s,
			background 0.2s,
			transform 0.2s;
	}
	.url-card:hover {
		border-color: var(--accent);
		background: var(--bg-deeper);
		transform: translateY(-2px);
	}
	.url-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}
	.url-card-icon {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
		border: 1px solid var(--rule);
		border-radius: 6px;
		background: var(--bg);
		color: var(--accent);
	}
	.url-card-icon svg {
		width: 1.2rem;
		height: 1.2rem;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.url-card-body {
		display: flex;
		flex-direction: column;
		min-width: 0;
		flex: 1;
	}
	.url-card-title {
		font-family: var(--serif);
		font-size: 1.08rem;
		font-weight: 500;
		line-height: 1.45;
	}
	.url-card-description {
		display: -webkit-box;
		margin-top: 0.35rem;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.6;
	}
	.url-card-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.75rem;
		color: var(--ink-mute);
		font-family: var(--mono);
		font-size: 0.72rem;
		line-height: 1.4;
	}
	.url-card-host {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.url-card-arrow {
		flex-shrink: 0;
		color: var(--accent);
		font-family: var(--sans);
		font-size: 1rem;
		transition: transform 0.2s;
	}
	.url-card:hover .url-card-arrow {
		transform: translate(2px, -2px);
	}
	@media (max-width: 480px) {
		.url-card {
			gap: 0.75rem;
			padding: 1rem;
		}
		.url-card-icon {
			width: 2.25rem;
			height: 2.25rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.url-card,
		.url-card-arrow {
			transition: none;
		}
	}
</style>
